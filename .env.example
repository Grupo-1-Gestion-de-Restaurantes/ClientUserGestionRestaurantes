# URL base del microservicio de autenticación (.NET).
# Coincide con AuthServiceGestionDeRestaurantes corriendo en local.
VITE_AUTH_URL=http://localhost:5233/api/v1

# URL base del microservicio de gestión (Node/Express).
# Coincide con GestionDeRestaurantes corriendo en local.
VITE_GESTION_URL=http://localhost:3007/gestionDeRestaurantes/v1

